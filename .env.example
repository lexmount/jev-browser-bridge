# TypeSafe's Jev decides which action to take.
JEV_API_KEY=
JEV_MODEL=jev-latest
# JEV_URL=https://api.typesafe.ai/v1/systemone

# A small text model writes strings, only when the operation is TYPE_TEXT.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=gpt-4o-mini
TEXT_MODEL_REASONING=none

# Moli, via Lexmount.
LEXMOUNT_API_KEY=
LEXMOUNT_PROJECT_ID=
LEXMOUNT_BASE_URL=https://api.lexmount.com
