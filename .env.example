# TypeSafe's Jev decides which action to take.
JEV_API_KEY=
JEV_MODEL=jev-latest
# JEV_URL=https://api.typesafe.ai/v1/systemone

# How many characters of page text one decision reads (retrieved, not truncated).
# JEV_EVIDENCE_CHARS=20000

# A small text model writes strings, only when the operation is TYPE_TEXT.
# Optional: goals that never type into a field do not need it.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=gpt-4o-mini
TEXT_MODEL_REASONING=none

# Moli, via Lexmount. Only for lexmount_session() / the CLI without --cdp;
# install with: uv sync --extra lexmount
LEXMOUNT_API_KEY=
LEXMOUNT_PROJECT_ID=
LEXMOUNT_BASE_URL=https://api.lexmount.com
